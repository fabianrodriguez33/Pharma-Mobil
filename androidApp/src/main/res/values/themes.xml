<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PharmaMobil" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FEFEFE</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.PharmaMobil.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FEFEFE</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.PharmaMobil</item>
    </style>
</resources>
